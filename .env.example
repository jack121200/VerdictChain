ENVIRONMENT=development

# Cloud LLM providers (see SKILL-agent-prompts.md Section 7 for routing)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Postgres — production/hosted (Neon/Supabase). Used only when ENVIRONMENT=production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Postgres — local dev (docker-compose)
POSTGRES_USER=verdictchain
POSTGRES_PASSWORD=change_me
POSTGRES_DB=verdictchain
LOCAL_DATABASE_URL=postgresql+psycopg://verdictchain:change_me@127.0.0.1:5433/verdictchain

# Redis (docker-compose)
REDIS_URL=redis://127.0.0.1:6379/0

# RabbitMQ (docker-compose)
RABBITMQ_USER=verdictchain
RABBITMQ_PASSWORD=change_me
RABBITMQ_URL=amqp://verdictchain:change_me@127.0.0.1:5672/

# JWT signing key for the FastAPI layer (Module 7, SKILL-security.md Section 2)
JWT_SECRET_KEY=change_me_to_a_long_random_value
