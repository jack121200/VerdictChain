ENVIRONMENT=development

# LLM provider: OpenAI is the only one. It answers every debate (manual injections and the live feed) and writes
# the one-sentence reason of a containment action. Write the line as OPENAI_API_KEY=sk-... (name, equals sign, key).
OPENAI_API_KEY=
# The model id your OpenAI account can use. Empty falls back to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
# Most tokens one answer may use. A model that thinks first spends its thinking from the same number.
OPENAI_MAX_OUTPUT_TOKENS=3000
# Hard budget: input + output tokens OpenAI may be asked for in any rolling 24 hours. A call that would start
# above it is refused before any request is sent. One debate is 30,000 to 55,000 tokens.
OPENAI_DAILY_TOKEN_LIMIT=2000000

# Postgres — production/hosted (Neon/Supabase). Used only when ENVIRONMENT=production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Postgres — local dev (docker-compose)
POSTGRES_USER=verdictchain
POSTGRES_PASSWORD=change_me
POSTGRES_DB=verdictchain
LOCAL_DATABASE_URL=postgresql+psycopg://verdictchain:change_me@127.0.0.1:5433/verdictchain

# Test database for pytest. Tests TRUNCATE tables, so this must NOT be the dev database:
# the suite refuses to run if its database name is `verdictchain`, or has no `test` in it.
TEST_DATABASE_URL=postgresql+psycopg://verdictchain:change_me@127.0.0.1:5433/verdictchain_test

# Redis (docker-compose)
REDIS_URL=redis://127.0.0.1:6379/0

# RabbitMQ (docker-compose)
RABBITMQ_USER=verdictchain
RABBITMQ_PASSWORD=change_me
RABBITMQ_URL=amqp://verdictchain:change_me@127.0.0.1:5672/

# JWT signing key for the FastAPI layer (Module 7, SKILL-security.md Section 2)
JWT_SECRET_KEY=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Debate daily caps (per analyst, and across all analysts). The token budget above is what bounds the cost.
DEBATE_DAILY_LIMIT_USER=30
DEBATE_DAILY_LIMIT_GLOBAL=120

# First SecOps Lead account for `python -m backend.scripts.bootstrap_lead` (idempotent)
BOOTSTRAP_LEAD_USERNAME=change_me
BOOTSTRAP_LEAD_PASSWORD=change_me

# Frontend image only (docker compose --profile app). The API address the BROWSER uses; Vite compiles it into the
# bundle, so changing it needs `docker compose --profile app up -d --build`. Unset means http://127.0.0.1:8000.
# VITE_API_BASE=http://127.0.0.1:8000

# How many investigators answer at once in a round (1 = one after the other)
DEBATE_MAX_PARALLEL_AGENTS=3

# How many debates run at once. Each runs its three investigators side by side, so 4 debates are about 12
# requests in flight: fine for a funded OpenAI key, too many for a free-tier one (use 1 there).
DEBATE_MAX_CONCURRENT=4

# Debate queue: debates waiting for a free slot (per analyst, and in total)
DEBATE_QUEUE_MAX_PER_USER=3
DEBATE_QUEUE_MAX_TOTAL=10

# Simulated live feed: logs arrive on their own and a flagged window starts an investigation
# (start it with POST /live/start, the Live page, or LIVE_FEED_AUTOSTART=true)
LIVE_FEED_AUTOSTART=false
LIVE_FEED_EVENTS_PER_SECOND=4
LIVE_FEED_ATTACK_SHARE=0.2
LIVE_FEED_QUEUE=live_log_events
LIVE_AUTO_INVESTIGATE=true
# Seconds between two automatic investigations from the same source window (network, logon, device, file)
LIVE_MIN_GAP_SECONDS=20
# Automatic investigations that may wait for a free debate slot at once
LIVE_MAX_QUEUED=4
LIVE_DAILY_CAP=80
# The live feed asks OpenAI for nothing before this many rows have streamed (the monitor scores windows from
# row 1 on its own, for free). The Live page can choose another number for each run.
LIVE_LLM_AFTER_ROWS=1500
