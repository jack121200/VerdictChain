ENVIRONMENT=development

# Cloud LLM providers (see SKILL-agent-prompts.md Section 7 for routing)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Postgres — production/hosted (Neon/Supabase). Used only when ENVIRONMENT=production.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Postgres — local dev (docker-compose)
POSTGRES_USER=verdictchain
POSTGRES_PASSWORD=change_me
POSTGRES_DB=verdictchain
LOCAL_DATABASE_URL=postgresql+psycopg://verdictchain:change_me@127.0.0.1:5433/verdictchain

# Test database for pytest. Tests TRUNCATE tables, so this must NOT be the dev database:
# the suite refuses to run if its database name is `verdictchain`, or has no `test` in it.
TEST_DATABASE_URL=postgresql+psycopg://verdictchain:change_me@127.0.0.1:5433/verdictchain_test

# Redis (docker-compose)
REDIS_URL=redis://127.0.0.1:6379/0

# RabbitMQ (docker-compose)
RABBITMQ_USER=verdictchain
RABBITMQ_PASSWORD=change_me
RABBITMQ_URL=amqp://verdictchain:change_me@127.0.0.1:5672/

# JWT signing key for the FastAPI layer (Module 7, SKILL-security.md Section 2)
JWT_SECRET_KEY=change_me_to_a_long_random_value

# Debate daily caps (per analyst, and across all analysts)
DEBATE_DAILY_LIMIT_USER=10
DEBATE_DAILY_LIMIT_GLOBAL=20

# First SecOps Lead account for `python -m backend.scripts.bootstrap_lead` (idempotent)
BOOTSTRAP_LEAD_USERNAME=change_me
BOOTSTRAP_LEAD_PASSWORD=change_me

# Frontend image only (docker compose --profile app). The API address the BROWSER uses; Vite compiles it into the
# bundle, so changing it needs `docker compose --profile app up -d --build`. Unset means http://127.0.0.1:8000.
# VITE_API_BASE=http://127.0.0.1:8000
